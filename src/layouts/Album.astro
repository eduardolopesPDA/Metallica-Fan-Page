---
/* Esqueleto comum das 5 páginas de álbum.
   Cada página entra com: loader, arte do hero, ferramentas extras, seção especial e camadas próprias. */
import Base from './Base.astro';
import Member from '../components/Member.astro';
import Tracklist from '../components/Tracklist.astro';
import Story from '../components/Story.astro';
import { story } from '../data/story.js';
import '../styles/story.css';
import { totalTime, neighbors } from '../data/albums.js';

const { album, fonts, notes = {}, tracklist = {}, hint = 'ou clique em qualquer lugar', withStory = false } = Astro.props;
const chapter = withStory ? story[album.slug] : null;
const { prev, next } = neighbors(album.slug);
const meta = [...album.meta, ['Duração', totalTime(album.tracks)]];
---
<Base
  title={`${album.name} · Metallica ${album.year}`}
  description={`Fan page não oficial sobre ${album.name} (${album.year}) e a formação que gravou o álbum.`}
  fonts={fonts}
  theme={album.theme}
>
  <div class="bg" aria-hidden="true"><slot name="bg" /></div>
  <canvas id="fx-back" aria-hidden="true"></canvas>
  <canvas id="fx-front" aria-hidden="true"></canvas>
  <slot name="overlays" />
  <div class="grain" aria-hidden="true"></div>
  <div class="cursor" aria-hidden="true"></div>

  <div class="loader" role="status" aria-live="polite" aria-label={`Carregando ${album.name}`}>
    <slot name="loader" />
  </div>

  <header class="nav">
    <a href="/" class="nav__logo" aria-label="Voltar à linha do tempo">METALLICA</a>
    <nav class="nav__links" aria-label="Integrantes">
      {album.members.map((mb) => <a href={`#${mb.id}`} data-target={mb.id}>{mb.last}</a>)}
    </nav>
    <div class="nav__tools">
      <slot name="tools" />
      <button class="sound" type="button" aria-pressed="false">
        <span class="sound__bars" aria-hidden="true"><i></i><i></i><i></i><i></i></span>
        <span class="sound__label">Som off</span>
      </button>
    </div>
  </header>

  <aside class="rail" aria-hidden="true">
    <div class="rail__track"><span></span></div>
    <span class="rail__value" id="rail-value">0</span>
    <span class="rail__unit">{album.meter.label}</span>
  </aside>

  <main id="top">
    <section class="hero" id="hero">
      <div class="hero__art" aria-hidden="true"><slot name="hero-art" /></div>
      <p class="hero__eyebrow">
        {album.eyebrow.map((e, i) => <>{i > 0 && <span class="dot" />}<span>{e}</span></>)}
      </p>
      <h1 class="hero__title">
        <span class="hero__line" data-split>{album.title[0]}</span>
        <span class="hero__line hero__line--big" data-split>{album.title[1]}</span>
      </h1>
      <p class="hero__sub">{album.sub}</p>
      <dl class="hero__meta">
        {meta.map(([k, v]) => <div><dt>{k}</dt><dd>{v}</dd></div>)}
      </dl>
      <div class="hero__actions">
        <a href={`#${album.members[0].id}`} class="btn">Conheça a formação</a>
        <span class="hero__hint">{hint}</span>
      </div>
      <div class="scroll-cue" aria-hidden="true"><span></span></div>
    </section>

    {chapter && <Story chapterId={album.slug} chapter={chapter} skipTo={album.members[0].id} next={next ? { href: `/${next.slug}/`, name: next.name, year: next.year } : { href: '/epilogo/', name: 'Epílogo', year: 'Epílogo' }} />}

    <div class="marquee" aria-label="Faixas do álbum">
      <div class="marquee__track">
        {album.tracks.map(([t]) => <><span>{t}</span><i aria-hidden="true"></i></>)}
        {album.tracks.map(([t]) => <><span aria-hidden="true">{t}</span><i aria-hidden="true"></i></>)}
      </div>
    </div>

    {album.members.map((mb, i) => (
      <Member member={mb} index={i} total={album.tracks.length} reverse={i % 2 === 1} note={notes[mb.id]} />
    ))}

    <slot name="special" />

    <Tracklist album={album} {...tracklist} />

    <footer class="footer">
      <nav class="album-nav" aria-label="Outros álbuns">
        {prev ? <a class="album-nav__prev" href={`/${prev.slug}/`}><small>← {prev.year}</small>{prev.name}</a> : <span />}
        <a class="album-nav__home" href="/">Linha do tempo</a>
        {next ? <a class="album-nav__next" href={`/${next.slug}/`}><small>{next.year} →</small>{next.name}</a> : <a class="album-nav__next" href="/epilogo/"><small>1991 →</small>Epílogo</a>}
      </nav>
      <p class="footer__note">Fan page não oficial, feita como estudo de design e animação. Sem afiliação com o Metallica ou suas gravadoras. Todo o visual é original. <a href="/fontes/">Fontes da história</a>.</p>
    </footer>
  </main>
</Base>
