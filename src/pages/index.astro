---
import Base from '../layouts/Base.astro';
import { albums, order } from '../data/albums.js';
import '../styles/home.css';
import '../styles/story.css';
import Story from '../components/Story.astro';
import { story } from '../data/story.js';

const fonts = 'https://fonts.googleapis.com/css2?family=Rubik+Dirt&family=Metal+Mania&family=IM+Fell+English+SC&family=Cinzel:wght@700;900&family=Archivo+Black&family=Inter:wght@400;500;700&display=swap';
const list = order.map((slug) => albums[slug]);
---
<Base
  title="Metallica 1983–1991 · Linha do tempo"
  description="Fan page não oficial: os cinco primeiros álbuns do Metallica, de Kill 'Em All ao Black Album, cada um com sua própria identidade."
  fonts={fonts}
  theme="home"
>
  <div class="cursor" aria-hidden="true"></div>

  <header class="home-nav">
    <span class="home-nav__logo">METALLICA</span>
    <button class="sound" type="button" aria-pressed="false">
      <span class="sound__bars" aria-hidden="true"><i></i><i></i><i></i><i></i></span>
      <span class="sound__label">Som off</span>
    </button>
  </header>

  <main>
    <section class="intro" aria-labelledby="intro-title">
      <svg class="turntable" viewBox="0 0 420 420" aria-hidden="true">
        <circle cx="190" cy="210" r="170" class="tt-platter" />
        <g class="tt-disc">
          <circle cx="190" cy="210" r="158" class="tt-vinyl" />
          {[150, 136, 122, 108, 94, 80].map((r) => <circle cx="190" cy="210" r={r} class="tt-groove" />)}
          <circle cx="190" cy="210" r="52" class="tt-label" />
          <circle cx="190" cy="210" r="5" class="tt-hole" />
        </g>
        <g class="tt-arm">
          <circle cx="380" cy="50" r="18" class="tt-pivot" />
          <path d="M380 50 L372 230 L318 300" class="tt-tube" />
          <rect x="300" y="292" width="30" height="16" rx="3" transform="rotate(38 315 300)" class="tt-head" />
        </g>
      </svg>
      <div class="intro__text">
        <p class="intro__kicker">Fan page não oficial · 1983 → 1991</p>
        <h1 class="intro__title" id="intro-title">Cinco discos.<br />Cinco tempestades.</h1>
        <p class="intro__sub">De Kill 'Em All ao Black Album: uma página para cada álbum, cada uma com seu próprio clima, seus efeitos e a formação que gravou o disco.</p>
        <p class="intro__hint">role para tocar a linha do tempo ↓</p>
      </div>
    </section>

    <Story chapterId="prologo" chapter={story.prologo} skipTo="linha-do-tempo" next={{ href: '#linha-do-tempo', name: "a linha do tempo" }} />

    <section class="timeline" id="linha-do-tempo" aria-label="Linha do tempo dos álbuns">
      <div class="timeline__track">
        {list.map((a, i) => (
          <>
            {i === 3 && (
              <aside class="interlude" aria-label="Mudança de formação em 1986">
                <p class="interlude__year">1986</p>
                <p class="interlude__text">✝ Cliff Burton<br /><span>10.02.1962 — 27.09.1986</span></p>
                <p class="interlude__next">Jason Newsted assume o baixo no fim do ano.</p>
              </aside>
            )}
            <article class={`station station--${a.theme}`} data-theme-key={a.theme}>
              <a class="disc" href={`/${a.slug}/`} aria-label={`Entrar em ${a.name}`}>
                <span class="disc__vinyl" aria-hidden="true"><span class="disc__label"><b>{a.year}</b><small>{a.name}</small></span></span>
                <span class="disc__fx" aria-hidden="true"></span>
              </a>
              <div class="station__info">
                <p class="station__n">{String(a.n).padStart(2, '0')} / 05 · {a.concept}</p>
                <p class="station__year" aria-hidden="true">{a.year}</p>
                <h2 class="station__title">{a.name}</h2>
                <p class="station__sub">{a.sub}</p>
                <p class="station__lineup">{a.members.map((m) => m.last).join(' · ')}</p>
                <a class="station__cta" href={`/${a.slug}/`}>Entrar no disco <span aria-hidden="true">→</span></a>
              </div>
            </article>
          </>
        ))}
      </div>
      <div class="ruler" aria-hidden="true">
        {[1983, 1984, 1985, 1986, 1987, 1988, 1989, 1990, 1991].map((y) => <span>{y}</span>)}
        <i class="ruler__head"></i>
      </div>
    </section>

    <footer class="home-footer">
      <p>Fan page não oficial, feita como estudo de design e animação. Sem afiliação com o Metallica ou suas gravadoras. Todo o visual é original: nenhuma capa, foto ou letra é reproduzida.</p>
      <p class="home-footer__links"><a href="/epilogo/">Epílogo</a> · <a href="/fontes/">Fontes da história</a></p>
    </footer>
  </main>
</Base>

<script>
  import { initHome } from '../scripts/home.js';
  initHome();
</script>
