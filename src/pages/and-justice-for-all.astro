---
import Album from '../layouts/Album.astro';
import { albums } from '../data/albums.js';
import '../styles/themes/justice.css';
const album = albums['and-justice-for-all'];
const fonts = 'https://fonts.googleapis.com/css2?family=Cinzel:wght@400;700;900&family=IBM+Plex+Mono:wght@400;500;600&display=swap';
---
<Album
  album={album}
  fonts={fonts}
  hint="clique para rachar a tela"
  tracklist={{ title: 'Pauta', numbering: 'docket' }}
>
  <Fragment slot="loader">
    <div class="ld-half ld-half--l"></div>
    <div class="ld-half ld-half--r"></div>
    <div class="ld-center">
      <svg viewBox="0 0 340 220" aria-hidden="true">
        <!-- balança (desenho original) -->
        <g stroke="#7fb39d" stroke-width="2" fill="none">
          <line x1="90" y1="70" x2="90" y2="190" /><path d="M60 196 H120 L110 186 H70 Z" />
          <g class="ld-beam"><line x1="30" y1="70" x2="150" y2="70" /><path d="M30 70 L18 110 H42 Z M150 70 L138 110 H162 Z" /></g>
        </g>
        <!-- martelo de juiz -->
        <rect x="200" y="186" width="110" height="14" rx="3" fill="#5a3a22" />
        <g class="ld-gavel">
          <rect x="246" y="60" width="8" height="96" rx="3" fill="#6b4426" transform="rotate(-60 250 150)" />
          <rect x="212" y="146" width="76" height="34" rx="8" fill="#7a4e2c" />
          <rect x="226" y="146" width="6" height="34" fill="#c9a24a" /><rect x="268" y="146" width="6" height="34" fill="#c9a24a" />
        </g>
      </svg>
      <p class="loader__label">Ordem no tribunal</p>
    </div>
    <svg class="ld-crack" viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true"><path d="M50 0 L48 18 L51 34 L47 52 L50 70 L48 86 L50 100" vector-effect="non-scaling-stroke" /></svg>
  </Fragment>

  <Fragment slot="hero-art">
    <svg class="hero-scale" viewBox="0 0 400 300" aria-hidden="true">
      <line x1="200" y1="92" x2="200" y2="270" /><path class="solid" d="M150 280 H250 L236 266 H164 Z" />
      <circle cx="200" cy="86" r="7" class="solid" />
      <g class="beam"><line x1="50" y1="92" x2="350" y2="92" /></g>
      <g class="pan pan--l"><line x1="50" y1="92" x2="22" y2="170" /><line x1="50" y1="92" x2="78" y2="170" /><path class="solid" d="M14 170 Q50 196 86 170 Z" /></g>
      <g class="pan pan--r"><line x1="350" y1="92" x2="322" y2="170" /><line x1="350" y1="92" x2="378" y2="170" /><path class="solid" d="M314 170 Q350 196 386 170 Z" /></g>
    </svg>
  </Fragment>

  <section slot="special" class="special" aria-labelledby="one-title">
    <div class="special__head">
      <p class="special__kicker">Faixa 04</p>
      <h2 class="special__title" id="one-title">Um sinal no escuro</h2>
      <p class="special__text">One é a faixa antiguerra que virou o primeiro videoclipe da banda. O clipe usa código Morse como a única voz de um soldado preso ao próprio corpo. A luz abaixo pisca o nome da música.</p>
    </div>
    <div class="morse" aria-label="A palavra ONE em código Morse">
      <div class="morse__light" aria-hidden="true"></div>
      <div class="morse__word" aria-hidden="true"><span>O</span><span>N</span><span>E</span></div>
      <p class="morse__code" aria-hidden="true">— — —&nbsp;&nbsp;&nbsp;— ·&nbsp;&nbsp;&nbsp;·</p>
    </div>
    <div class="tribute">
      <h3>To Live Is to Die</h3>
      <p>Quase toda instrumental, a faixa foi construída sobre riffs que Cliff Burton deixou gravados. Ele aparece nos créditos da faixa, ao lado de Hetfield e Ulrich.</p>
    </div>
  </section>
</Album>

<script>
  import { boot } from '../scripts/core/page.js';
  import theme from '../scripts/themes/justice.js';
  boot(theme);
</script>
