---
import Album from '../layouts/Album.astro';
import { albums } from '../data/albums.js';
import '../styles/themes/kea.css';
const album = albums['kill-em-all'];
const fonts = 'https://fonts.googleapis.com/css2?family=Rubik+Dirt&family=Archivo:wght@400;600;800&family=Courier+Prime:wght@400;700&display=swap';
const reel = (cx) => `<g class="reel"><circle cx="${cx}" cy="70" r="22" fill="#e6ddc7"/><circle cx="${cx}" cy="70" r="8" fill="#15120f"/>${[0, 60, 120, 180, 240, 300].map(a => `<rect x="${cx - 2}" y="50" width="4" height="10" fill="#15120f" transform="rotate(${a} ${cx} 70)"/>`).join('')}</g>`;
---
<Album
  album={album}
  fonts={fonts}
  hint="clique para martelar · segure para carregar o golpe"
  tracklist={{ title: 'Lado A / Lado B', sides: true }}
>
  <Fragment slot="loader">
    <svg class="cassette" viewBox="0 0 320 200" aria-hidden="true">
      <rect x="4" y="4" width="312" height="192" rx="12" fill="none" stroke="#e6ddc7" stroke-width="4" />
      <rect x="26" y="22" width="268" height="40" fill="#b3121b" />
      <text x="160" y="49" text-anchor="middle" fill="#e6ddc7" font-family="Courier Prime, monospace" font-weight="700" font-size="16" letter-spacing="3">METALLICA · 1983</text>
      <rect x="70" y="44" width="180" height="52" rx="26" fill="none" stroke="#e6ddc7" stroke-width="3" transform="translate(0 4)" />
      <Fragment set:html={reel(108) + reel(212)} />
      <path d="M60 196 L84 150 H236 L260 196" fill="none" stroke="#e6ddc7" stroke-width="3" />
    </svg>
    <p class="loader__label">Rebobinando a fita</p>
    <p class="loader__count"><span id="tape">000</span></p>
    <span class="play">▶ PLAY</span>
  </Fragment>

  <Fragment slot="hero-art">
    <span class="scrap scrap--1">Estreia · 1983</span>
    <span class="scrap scrap--2 scrap--red">Ao vivo</span>
    <span class="scrap scrap--3">Thrash metal</span>
    <span class="scrap scrap--4">Megaforce</span>
  </Fragment>

  <section slot="special" class="special tape-story" aria-labelledby="tape-title">
    <div class="special__head">
      <p class="special__kicker">Lado B da história</p>
      <h2 class="special__title" id="tape-title">Da garagem ao estúdio</h2>
      <p class="special__text">Dois anos entre um anúncio de jornal e um disco nas lojas, contados numa fita que corre com o scroll.</p>
    </div>
    <div class="reels" aria-hidden="true">
      {[0, 1].map(() => (
        <svg class="big-reel" viewBox="0 0 120 120"><circle cx="60" cy="60" r="56" fill="#15120f" /><circle cx="60" cy="60" r="20" fill="#e6ddc7" />{[0, 60, 120, 180, 240, 300].map((a) => <rect x="56" y="10" width="8" height="26" fill="#e6ddc7" transform={`rotate(${a} 60 60)`} />)}</svg>
      ))}
    </div>
    <div class="tape-track">
      <span class="tape-ribbon" aria-hidden="true"></span>
      {album.timeline.map(([when, what]) => (
        <div class="milestone" data-egg={when === 'Abr 1983' ? '' : undefined}><strong>{when}</strong><p>{what}</p></div>
      ))}
    </div>
  </section>
</Album>

<script>
  import { boot } from '../scripts/core/page.js';
  import theme from '../scripts/themes/kea.js';
  boot(theme);
</script>
