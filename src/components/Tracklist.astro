---
/* Lista de faixas. numbering: 'arabic' | 'roman' | 'docket'. sides: divide em Lado A / Lado B.
   Se o álbum tiver dmNotes, os créditos "DM" viram botões com uma curiosidade (easter egg). */
import { LEGEND } from '../data/albums.js';
const { album, title = 'Faixas', numbering = 'arabic', sides = false } = Astro.props;

const ROMAN = ['I', 'II', 'III', 'IV', 'V', 'VI', 'VII', 'VIII', 'IX', 'X', 'XI', 'XII'];
const num = (i) => numbering === 'roman' ? ROMAN[i] : numbering === 'docket' ? `Nº ${String(i + 1).padStart(2, '0')}` : String(i + 1).padStart(2, '0');
const notes = album.dmNotes || {};
const rows = album.tracks.map(([t, c, d], i) => ({ n: num(i), t, creds: c.split(' '), d, note: notes[t] }));
const half = Math.ceil(rows.length / 2);
const groups = sides ? [['Lado A', rows.slice(0, half)], ['Lado B', rows.slice(half)]] : [[null, rows]];
---
<section class="tracklist" id="faixas" aria-labelledby="faixas-title">
  <h3 class="tracklist__title" id="faixas-title" set:html={title} />
  <div class:list={['tracklist__groups', { 'tracklist__groups--sides': sides }]}>
    {groups.map(([label, list]) => (
      <div class="tracklist__group">
        {label && <p class="tracklist__side">{label}</p>}
        <ol class="tracks">
          {list.map((r) => (
            <li class:list={{ 'has-dm': !!r.note }}>
              <span class="n">{r.n}</span>
              <span class="t">{r.t}</span>
              <span class="c">
                {r.creds.map((c, k) => (
                  <>
                    {k > 0 && <span class="sep"> · </span>}
                    {c === 'DM' && r.note
                      ? <button class="cred-dm" type="button" data-note={r.note} aria-label={`Dave Mustaine: curiosidade sobre ${r.t}`}>DM</button>
                      : <span class="cred">{c}</span>}
                  </>
                ))}
              </span>
              <span class="d">{r.d}</span>
            </li>
          ))}
        </ol>
      </div>
    ))}
  </div>
  <p class="tracklist__legend">{LEGEND}</p>
  {album.mustaine && <p class="tracklist__hint">Um ex-integrante deixou rastros neste disco. Procure as iniciais dele.</p>}
</section>
